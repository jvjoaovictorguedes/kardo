# Mesmo banco Postgres do Jota Studio (repositório "basio") — não crie um banco novo.
DATABASE_URL="postgresql://basio:basio@localhost:5432/basio_studio?schema=public"

NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="gere-um-valor-com-openssl-rand-base64-32"

# Tamanho máximo de arquivo aceito em upload (bytes) quando fica no Postgres.
MAX_UPLOAD_SIZE_BYTES="20971520"

# Acima desse tamanho (bytes), o arquivo vai para o Google Drive em vez do Postgres.
# Enquanto as credenciais do Drive não estiverem configuradas, uploads grandes ficam bloqueados
# com um aviso — nada é salvo truncado nem quebra o upload.
DRIVE_STORAGE_THRESHOLD_BYTES="8388608"

# Credenciais de uma conta de serviço do Google (Drive API) com uma pasta compartilhada
# com ela. Deixe em branco por enquanto — o módulo de upload de arquivos grandes avisa
# isso quando faltar, em vez de falhar silenciosamente.
GOOGLE_DRIVE_CLIENT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""
GOOGLE_DRIVE_FOLDER_ID=""

# URL base usada nos links de convite enviados ao cliente (e-mail/WhatsApp).
NEXT_PUBLIC_APP_URL="http://localhost:3001"
